{
  "servers": {
    "langchain": {
      "command": "/home/douglas/.config/nvm/versions/node/v24.7.0/bin/npx",
      "args": ["-y", "langchain-mcp"],
      "env": {
        "LANGCHAIN_API_KEY": "${input:langchainApiKey}",
        "PATH": "/home/douglas/.config/nvm/versions/node/v24.7.0/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "fetch": {
      "command": "/home/douglas/.config/nvm/versions/node/v24.7.0/bin/npx",
      "args": ["-y", "mcp-server-fetch-typescript"],
      "env": {
        "PATH": "/home/douglas/.config/nvm/versions/node/v24.7.0/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "flowbite": {
      "command": "/home/douglas/.config/nvm/versions/node/v24.7.0/bin/npx",
      "args": ["-y", "flowbite-mcp"],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${input:figmaToken}",
        "PATH": "/home/douglas/.config/nvm/versions/node/v24.7.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      }
    },
    "docs-langchain": {
      "url": "https://docs.langchain.com/mcp"
    },
    "next-devtools": {
      "command": "/home/douglas/.config/nvm/versions/node/v24.7.0/bin/npx",
      "args": ["-y", "next-devtools-mcp@latest"],
      "env": {
        "PATH": "/home/douglas/.config/nvm/versions/node/v24.7.0/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "openaiDeveloperDocs": {
      "type": "http",
      "url": "https://developers.openai.com/mcp"
    }
  },
  "inputs": [
    {
      "id": "figmaToken",
      "type": "promptString",
      "description": "Figma Personal Access Token",
      "password": true
    },
    {
      "id": "langchainApiKey",
      "type": "promptString",
      "description": "LangChain API Key (LangSmith)",
      "password": true
    }
  ]
}
